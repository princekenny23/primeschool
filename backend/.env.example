# Copy to .env and fill in real values. Never commit .env.
# Render provides DATABASE_URL. Use this instead of the DB_* variables below
# when deploying the backend.
DATABASE_URL=

# Local development fallback when DATABASE_URL is empty.
DB_NAME=primeschool
DB_USER=postgres
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000
